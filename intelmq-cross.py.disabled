#!/usr/bin/env python3
"""Cross-check recent Wazuh IPs against the IntelMQ events DB (read-only).

Reads IPs seen in the last --hours from the local threat DB, batch-queries
the IntelMQ PostgreSQL via SSH to 10.0.1.50 (inline python, no files left
there), and writes intelmq-hits.json. Report-only: nothing is pushed anywhere.
"""
import argparse
import json
import sqlite3
import subprocess
import sys
import os
from datetime import datetime, timezone
from pathlib import Path

DB = "/root/.config/linux-log-threat-hunt/threat-intel.db"
OUT = Path("/root/.config/soc-orchestrator/intelmq-hits.json")
REMOTE = ["sshpass", "-e", "ssh", "-o", "StrictHostKeyChecking=no",
          "-o", "PreferredAuthentications=password", "-o", "PubkeyAuthentication=no",
          "-o", "ConnectTimeout=10", "kowalski@10.0.1.50"]

QUERY = r'''
import json, sys, yaml, psycopg2
ips = json.loads(sys.argv[1])
p = yaml.safe_load(open("/home/kowalski/intelmq-run/etc/runtime.yaml"))["sql-output"]["parameters"]
conn = psycopg2.connect(host=p["host"], port=p["port"], dbname=p["database"], user=p["user"],
                        password=p["password"], connect_timeout=15, sslmode=p.get("sslmode", "disable"))
cur = conn.cursor()
cur.execute(
    'SELECT "source.ip", array_agg(DISTINCT "feed.name"), max("classification.type"::text), '
    'max("source.as_name"), max(coalesce("time.source", "time.observation")) '
    'FROM events WHERE "source.ip" = ANY(%s::inet[]) GROUP BY 1', (ips,))
rows = [{"ip": r[0], "feeds": r[1], "type": r[2], "as_name": r[3],
         "last_seen": str(r[4])} for r in cur.fetchall()]
conn.close()
print(json.dumps(rows))
'''

HIGH_FEEDS = {"Feodo Tracker", "C2 Tracker", "CINS Army List", "Drop", "Dropv6"}
MEDIUM_FEEDS = {"URLs", "Public feed", "Latest", "Bots", "Strong IPs"}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--hours", type=int, default=24)
    ap.add_argument("--limit", type=int, default=2000)
    args = ap.parse_args()

    conn = sqlite3.connect(DB)
    cur = conn.cursor()
    cur.execute("select ip from iocs where last_seen > datetime('now', ?)",
                (f"-{args.hours} hours",))
    ips = [r[0] for r in cur.fetchall()][: args.limit]
    conn.close()
    print(f"local_ips={len(ips)}")
    if not ips:
        OUT.write_text(json.dumps({"checked": 0, "hits": []}, indent=2) + "\n")
        return

    os.environ.setdefault("SSHPASS", "Pwdn0s@fe;")
    import base64, shlex
    b64 = base64.b64encode(QUERY.encode()).decode()
    payload = shlex.quote(json.dumps(ips))
    remote = REMOTE + [f"echo {b64} | base64 -d | /home/kowalski/intelmq-run/venv/bin/python - {payload}"]
    proc = subprocess.run(remote, capture_output=True, text=True,
                          timeout=180, env=os.environ)
    if proc.returncode:
        print(f"FAIL intelmq query rc={proc.returncode}: {proc.stderr[-300:]}", file=sys.stderr)
        sys.exit(1)
    rows = json.loads(proc.stdout.strip().splitlines()[-1])

    high = []
    medium = []
    for r in rows:
        r["high"] = sorted(set(r["feeds"]) & HIGH_FEEDS) != []
        if r["high"]:
            high.append(r)
        elif sorted(set(r["feeds"]) & MEDIUM_FEEDS):
            medium.append(r)
    hits = {
        "checked": len(ips),
        "matched": len(rows),
        "high": len(high),
        "medium": len(medium),
        "generated": datetime.now(timezone.utc).isoformat(),
        "high_hits": high,
        "hits": rows,
    }
    OUT.write_text(json.dumps(hits, indent=2) + "\n")
    print(f"matched={len(rows)} high={len(high)} medium={len(medium)}")
    by_feed = {}
    for r in rows:
        for f in r["feeds"]:
            by_feed[f] = by_feed.get(f, 0) + 1
    for f, n in sorted(by_feed.items(), key=lambda kv: -kv[1]):
        print(f"  feed {f}: {n}")
    for r in high[:10]:
        print(f"  HIGH {r['ip']} {r['feeds']} {r.get('as_name') or ''}")


if __name__ == "__main__":
    main()
